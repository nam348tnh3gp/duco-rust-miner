from flask import Flask, request, Response, jsonify
import requests
import logging
from urllib.parse import urlparse

# Cấu hình logging
logging.basicConfig(level=logging.INFO)

app = Flask(__name__)

class HTTPProxy:
    def __init__(self):
        self.session = requests.Session()
        # Giữ nguyên User-Agent để mô phỏng thiết bị di động
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 14_0 like Mac OS X) AppleWebKit/605.1.15'
        })
   
    def proxy_request(self, url, method='GET', headers=None, data=None):
        """Proxy HTTP request"""
        try:
            # Chỉ cho phép các phương thức an toàn (safe methods) cho GET/image proxy
            if method.upper() not in ['GET', 'HEAD']:
                method = 'GET'
               
            response = self.session.request(
                method=method.upper(),
                url=url,
                headers=headers,
                data=data,
                timeout=60,  # Tăng timeout để xử lý site chậm như YouTube
                allow_redirects=True
            )
            return {
                'success': True,
                'status_code': response.status_code,
                'content': response.content,
                'headers': dict(response.headers),
                'url': response.url
            }
        except Exception as e:
            logging.error(f"Error during proxy request to {url}: {e}")
            return {'success': False, 'error': str(e)}

proxy = HTTPProxy()

def is_safe_url(url):
    """Validate URL để tránh proxy unsafe domains"""
    try:
        result = urlparse(url)
        if result.scheme not in ('http', 'https'):
            return False
        domain = result.netloc.lower()
        if 'localhost' in domain or domain.startswith(('127.', '192.168.', '10.', '::1')):
            return False
        return True
    except:
        return False

